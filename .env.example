# --- KeyRock — configuration d'exemple ---
# Copiez ce fichier en `.env` puis ajustez. NE versionnez jamais `.env`.

# Serveur API
KEYROCK_API_HOST=0.0.0.0
KEYROCK_API_PORT=8000

# Observabilité (CRITICAL | ERROR | WARNING | INFO | DEBUG)
KEYROCK_LOG_LEVEL=INFO

# Bornes de génération
KEYROCK_TOKEN_MIN_LENGTH=8
KEYROCK_TOKEN_MAX_LENGTH=1024

# Entropie minimale requise, en bits (NIST SP 800-63B)
KEYROCK_TOKEN_MIN_ENTROPY=80

# Quota de requêtes par IP et par minute
KEYROCK_RATE_LIMIT_PER_MINUTE=60

# Origines CORS autorisées (JSON de liste, ex. ["https://app.vextra.agency"])
KEYROCK_CORS_ALLOW_ORIGINS=[]

# --- Déploiement (lues par docker-compose.yml, pas par l'application) ---

# Domaine public routé par Traefik. Doit pointer ici.
KEYROCK_DOMAIN=api.keyrock.local

# Contact Let's Encrypt pour les certificats de production.
ACME_EMAIL=contact@vextra.agency
